# Copy to .env and fill in. Never commit .env.
# Judges run with no credentials:
SAMPLE_MODE=true

# Zetaris (local instance). Dashboard: http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=
ZETARIS_ORG_ID=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=

# Meterless runtime token (from the sponsor claim steps on HackOS)
METERLESS_RUNTIME_TOKEN=

# NVIDIA key for Nemotron (optional, from the sponsor claim steps on HackOS)
NVIDIA_API_KEY=
